// risk-quality.dot — 蒙电信产助手 代码质量风险关系图
// 生成技能：architecture-visualization:risk-quality-reviewer（场景）+ graphviz（格式）
// 渲染：dot -Tsvg risk-quality.dot -o risk-quality.svg
// 每个节点的 sourceRefs 与 confidence 与 architecture-review.md 的发现表一一对应（F1..F35）
digraph risk_quality {
  rankdir=TB;
  compound=true;
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#f5f5f5", color="#9e9e9e"];
  edge [fontname="Helvetica", fontsize=10, color="#616161"];

  // ---------- 观察面：门禁与它看不见的东西 ----------
  subgraph cluster_gates {
    label="现有门禁（全绿）"; style="rounded,dashed"; color="#9e9e9e"; fontsize=12;
    G_tsc   [label="tsc --noEmit\n0 error", fillcolor="#e8f5e9"];
    G_vitest[label="vitest run\n34 files / 398 tests 全绿", fillcolor="#e8f5e9"];
    G_build [label="vite build rc=0", fillcolor="#e8f5e9"];
    G_eq    [label="globalCssEquivalence\n源码级 + dist 级对账", fillcolor="#e8f5e9"];
  }

  // ---------- 风险簇 ----------
  subgraph cluster_correctness {
    label="簇 A｜同一件事两套口径（P0）"; style="rounded,filled"; fillcolor="#fff3f3"; color="#c62828"; fontsize=12;
    R_F1 [label="F1 list_roles 引用不存在的列\nroles.deleted_at｜H｜high\n(SQLITE 已复现 Parse error)", fillcolor="#ffcdd2", color="#b71c1c"];
    R_F2 [label="F2 copy_username 只要 accounts.read\nvs 视图无 view_secret 不解密用户名｜H｜high", fillcolor="#ffcdd2", color="#b71c1c"];
    R_F3 [label="F3 导入不过弱协议闸门\n(交互路径过)｜H｜high", fillcolor="#ffcdd2", color="#b71c1c"];
    R_F4 [label="F4 target_detail 参数错位\nis_insecure_protocol 恒 false｜H｜high", fillcolor="#ffcdd2", color="#b71c1c"];
    R_F5 [label="F5 取数键 targetsPaged vs\n作废键 ['targets'] 前缀不匹配｜H｜high", fillcolor="#ffcdd2", color="#b71c1c"];
    R_F6 [label="F6 RevealField 无响应世代守卫\n迟到明文写进已清空的格｜M-H｜high", fillcolor="#ffe0b2", color="#e65100"];
    R_F7 [label="F7 回收站列表不做记录级可见性｜M-H｜high", fillcolor="#ffe0b2", color="#e65100"];
    R_F8 [label="F8 软删恢复 UI 无入口\n(命令+面板+测试都在，没人挂)｜H｜high", fillcolor="#ffcdd2", color="#b71c1c"];
    R_F15[label="F15 编辑一次可能覆盖 allowedOrigin\nlauncher.rs 零后端测试｜M｜medium", fillcolor="#ffe0b2"];
    R_F27[label="F27 容器导出→导入不完全可逆\n/ 恢复强制置 active｜L-M｜medium", fillcolor="#ffe0b2"];
  }

  subgraph cluster_perf {
    label="簇 B｜规模相关的阻塞（P1）"; style="rounded,filled"; fillcolor="#fff8e1"; color="#ef6c00"; fontsize=12;
    R_F9  [label="F9 每次写命令全量重建搜索索引\n每凭据 3 相关子查询 + 1 次 AES-GCM 解密\n全程持唯一连接锁｜H｜high", fillcolor="#ffcc80", color="#e65100"];
    R_F10 [label="F10 81 条命令全同步\n0 async / 0 spawn_blocking\n双 Argon2id、64MB xlsx、ureq 下载\n(线程归属=medium)｜M｜high", fillcolor="#ffe0b2"];
    R_F19 [label="F19 vault_item_acl 只读不写\nACL 分支每行白跑｜M｜high", fillcolor="#ffe0b2"];
    R_F24 [label="F24 similarTargets 无防抖\n(另两处都防抖)｜L｜high", fillcolor="#fff3e0"];
  }

  subgraph cluster_trust {
    label="簇 C｜本机信任边界与可诊断性（P1）"; style="rounded,filled"; fillcolor="#ede7f6"; color="#4527a0"; fontsize=12;
    R_F11 [label="F11 IPC 鉴权前 read_line 无上限\n每连接裸 spawn｜M｜high", fillcolor="#d1c4e9"];
    R_F12 [label="F12 先 write 后 chmod 0600\nchmod 失败被 let _ = 吞\nWindows 无收紧｜M｜high", fillcolor="#d1c4e9"];
    R_F13 [label="F13 map_err(|_| Internal) 成片\nDisplay 不含 cause｜M｜high", fillcolor="#d1c4e9"];
    R_F14 [label="F14 清单解析失败→报源不可达｜M｜high", fillcolor="#d1c4e9"];
    R_F28 [label="F28 sourcemap 读 TAURI_DEBUG\n= v1 变量名（v2 为 TAURI_ENV_DEBUG）\n任何构建都无 map｜M-H｜high", fillcolor="#d1c4e9"];
  }

  subgraph cluster_testability {
    label="簇 D｜覆盖假象（让 A/B/C 长期存活的原因）"; style="rounded,filled"; fillcolor="#e1f5fe"; color="#01579b"; fontsize=12;
    R_F29 [label="F29 api.ts(唯一 IPC 边界) 零测试\n被 17 个文件整体 mock｜H｜high", fillcolor="#b3e5fc", color="#01579b"];
    R_F30 [label="F30 92 生产文件中 19 个\n任何测试都到不了｜H｜high", fillcolor="#b3e5fc", color="#01579b"];
    R_F31 [label="F31 主门禁基线=名字排序取最新快照\nBASELINE.css.sha256 无人校验｜H｜high", fillcolor="#b3e5fc", color="#01579b"];
    R_F34 [label="F34 断实现细节非行为\na11y 错误关联 0 断言\nfireEvent 275 vs user-event 1｜M｜high", fillcolor="#cfe6f5"];
    R_F21 [label="F21 无 CI（0 工作流）｜M｜high", fillcolor="#cfe6f5"];
  }

  subgraph cluster_artifact {
    label="簇 E｜产物与依赖卫生（P2）"; style="rounded,filled"; fillcolor="#f1f8e9"; color="#33691e"; fontsize=12;
    R_F16 [label="F16 死代码簇：StatsStrip(其类已不在 CSS)\nstate/shell.ts、业务 Pagination、\nDeletedItemsPanel/RecentAccessPanel｜M｜high", fillcolor="#dcedc8"];
    R_F17 [label="F17 npm 两枚 Tauri JS 插件包 0 引用｜L｜high", fillcolor="#f1f8e9"];
    R_F18 [label="F18 Rust regex/once_cell/subtle 0 引用\n(未逐条复核)｜L｜medium", fillcolor="#f1f8e9"];
    R_F20 [label="F20 :root 里 27 枚 shadcn 别称\n产物中无任何 var() 引用\n改 --primary 不生效｜L｜high", fillcolor="#dcedc8"];
    R_F33 [label="F33 externalBin 只有 aarch64-apple-darwin\nbeforeBuildCommand 不建 sidecar｜M｜high", fillcolor="#dcedc8"];
    R_F32 [label="F32 CSP 三处两份文本（漂移无守卫）｜M｜high", fillcolor="#f1f8e9"];
    R_F35 [label="F35 12 枚同名顶层类需逐条判层｜L｜medium", fillcolor="#f1f8e9"];
  }

  // ---------- 因果：为什么全绿却坏着 ----------
  R_F29 -> R_F1  [label="掩盖：命令级 SQL 无人跑"];
  R_F29 -> R_F4  [label="掩盖：前端 mock 喂 true"];
  R_F29 -> R_F5  [label="掩盖：无 key 一致性契约"];
  R_F29 -> R_F7  [label="掩盖：恢复侧零测试"];
  R_F31 -> G_eq  [label="基线可静默翻转", style=dashed, color="#c62828"];
  R_F21 -> G_vitest [label="398 条从未自动执行", style=dashed];
  R_F30 -> R_F8  [label="回收站/设置页只剩源码级证据"];
  R_F34 -> G_vitest [label="类名/CSS 变量被当断言", style=dashed];

  // ---------- 簇内放大 ----------
  R_F3  -> R_F4  [label="叠加：建得进来又看不见"];
  R_F9  -> R_F10 [label="同步执行放大阻塞"];
  R_F19 -> R_F9  [label="每行多跑一次 ACL 子查询"];
  R_F13 -> R_F28 [label="错误无 cause + 无 map\n= 现场两眼一抹黑"];
  R_F12 -> R_F11 [label="同一 trust boundary:\n同机任意进程"];

  // ---------- 代码锚点（L4）----------
  subgraph cluster_anchors {
    label="代码锚点（复核入口）"; style="rounded"; color="#9e9e9e"; fontsize=11;
    node [shape=note, fillcolor="#fafafa"];
    A1 [label="commands/vault.rs:240\ndb/repo.rs:909-912\nmigrations/0001_init.sql:57"];
    A2 [label="commands/accounts.rs:38-55,196,379-395,460-473"];
    A3 [label="importexport.rs:796-819"];
    A4 [label="pages/AccountsPage.tsx:58,91\ndata/ExportPanel.tsx:31"];
    A5 [label="state.rs:113-120 db/repo.rs:667-781"];
    A6 [label="ipc.rs:47-77"];
    A7 [label="src/lib/api.ts（81 call）\nvite.config.ts:21\ntauri.conf.json:31,39"];
    A8 [label="globalCssEquivalence.test.ts:26-32"];
  }
  R_F1 -> A1 [style=dotted]; R_F4 -> A1 [style=dotted]; R_F2 -> A2 [style=dotted];
  R_F7 -> A2 [style=dotted]; R_F8 -> A2 [style=dotted]; R_F6 -> A2 [style=dotted];
  R_F3 -> A3 [style=dotted]; R_F5 -> A4 [style=dotted]; R_F9 -> A5 [style=dotted];
  R_F11 -> A6 [style=dotted]; R_F12 -> A6 [style=dotted]; R_F28 -> A7 [style=dotted];
  R_F33 -> A7 [style=dotted]; R_F32 -> A7 [style=dotted]; R_F29 -> A7 [style=dotted];
  R_F31 -> A8 [style=dotted];

  // ---------- 图例 ----------
  legend [label=<<table border="0" cellpadding="4">
    <tr><td bgcolor="#ffcdd2">H · 已复现/直接代码证据（confidence high）</td></tr>
    <tr><td bgcolor="#ffe0b2">M-H / M · 结构确证，影响面或时长待测</td></tr>
    <tr><td bgcolor="#d1c4e9">本机信任边界与可诊断性</td></tr>
    <tr><td bgcolor="#b3e5fc">可测试性缺口（放大其它所有风险）</td></tr>
    <tr><td bgcolor="#dcedc8">产物与依赖卫生</td></tr>
  </table>, shape=plain, fillcolor=white, color="#9e9e9e", labelloc=t];
}
