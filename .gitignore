# 依赖与构建产物
node_modules/
dist/
# 浏览器扩展 zip 由 scripts/package-extension.mjs 产出，Release 上传用，不入库
dist-extension/
src-tauri/target/
src-tauri/gen/schemas/

# 打包用的 sidecar 二进制由 scripts/prepare-host-binary.sh 生成，不入库
src-tauri/binaries/

# 本地数据与密钥（永不提交）
*.db
*.db-journal
# SQLCipher 的 WAL 与共享内存副本里是尚未合并回主库的页，含明文凭据的风险与 .db 同级
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
.env
.env.*
*.key
*.p12
*.mobileprovision
# 浏览器扩展的 RSA 私钥（extension/manifest.json 的 key 是它的公钥）。
# 仓库是公开的：私钥一旦入库，任何人都能打成同 ID 的包冒充扩展。
# 丢了也不影响分发 —— ID 由 manifest 里的公钥推导，加载未打包扩展不需要私钥；
# 只有要出 .crx/上架商店时才用得上。重新生成会让所有已登记用户的 ID 变化。
secrets/

# 视觉轮开工前打的快照目录：throwaway 产物，不再充当版本控制。
# 对账基线已搬进版本库固定目录 baseline-css-20261019/（见 globalCssEquivalence.test.ts 的 BASELINE_SNAPSHOT）
.backup-*/

# 编辑器与系统
.DS_Store
.idea/
.vscode/
*.log
coverage/

# OCR 模型由 scripts/prepare-ocr-models.mjs 下载并校验，不入库。
# 只忽略模型目录本身：上层 resources/ocr/ 必须存在，否则 tauri_build 会因为
# bundle.resources 的源路径不存在而让任何一次 cargo build / cargo test 直接失败。
src-tauri/resources/ocr/ppocrv5/

# tsc --noEmit / --incremental 的缓存，本机产物不入库
*.tsbuildinfo
