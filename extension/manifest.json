{
  "manifest_version": 3,
  "name": "蒙电信产助手 · 安全填充",
  "description": "配合桌面应用「蒙电信产助手」使用的一次性凭据填充扩展：仅在桌面应用已发起本次填充、且当前页面 Origin 与台账精确匹配时工作；不存储任何凭据，永不自动提交表单。",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "蒙电信产助手 填充状态"
  }
}
