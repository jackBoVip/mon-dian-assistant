{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "蒙电信产助手",
  "mainBinaryName": "mon-dian-assistant",
  "version": "1.0.0",
  "identifier": "com.mda.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "蒙电信产助手",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-ancestors 'none'",
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "rpm", "appimage"],
    "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/mda_fill_host"],
    "category": "Utility",
    "shortDescription": "本地优先、安全优先的跨平台凭据保险库",
    "longDescription": "蒙电信产助手：账号台账、全局快捷搜索与多条件查询、浏览器安全填充、终端连接入口，全部数据本机加密存储。",
    "copyright": "© 内蒙古电力业务场景项目组",
    "license": "Proprietary",
    "linux": { "deb": { "section": "utils" } },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": { "language": "zh-CN" }
    }
  }
}
